APP_NAME=Medical AI API
APP_ENV=local
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
MODEL_SCHEMAS=app_db,vector_db
VITE_API_URL=http://localhost:8000/api
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_MINUTES=10

# SMTP를 설정하지 않으면 로컬 환경에서 인증 코드가 API 응답에 포함됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Cloudflare R2 프로필 이미지 저장소
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://assets.example.com

# 공통 ai/ocr Core (PaddleOCR 모델은 최초 OCR 실행 시 다운로드될 수 있습니다.)
OCR_MAX_FILE_SIZE_MB=20
OCR_MAX_PDF_PAGES=50
OCR_NATIVE_TEXT_MIN_CHARS=20
OCR_SIGNIFICANT_IMAGE_AREA_RATIO=0.03
OCR_PDF_RENDER_DPI=200
OCR_MAX_IMAGE_SIDE=2400
OCR_MAX_IMAGE_PIXELS=40000000
OCR_PADDLE_DEVICE=cpu
OCR_PADDLE_LANGUAGE=korean
OCR_MIN_CONFIDENCE=0.5
OCR_ENABLE_DENOISE=true
OCR_ENABLE_DESKEW=true
OCR_JOB_TTL_MINUTES=60
OCR_MAX_PENDING_JOBS=5
OCR_MAX_OFFICE_UNCOMPRESSED_SIZE_MB=200
OCR_MAX_OFFICE_ARCHIVE_ENTRIES=5000

# Vast.ai 2× V100에서 실행하는 5개 모델 공통 원격 추론 API
LLM_REMOTE_ENABLED=false
LLM_REMOTE_BASE_URL=http://your-vast-host:published-port
LLM_REMOTE_API_KEY=
LLM_REMOTE_GEMMA_MODEL=gemma
LLM_REMOTE_MEDGEMMA_FINAL_MODEL=medgemma-final
LLM_REMOTE_MEDGEMMA_DATASET_MODEL=medgemma-dataset
LLM_REMOTE_QWEN_MODEL=qwen
LLM_REMOTE_LLAMA_MODEL=llama
LLM_REMOTE_TIMEOUT_SECONDS=300
LLM_REMOTE_MAX_CONCURRENCY=5

# Gemini는 LLM으로 사용하지 않고 OCR Chunk Embedding에만 사용합니다.
# DB의 VECTOR(1024)와 차원을 일치시켜야 합니다.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60

# ai/rag의 EmbeddingProvider 선택 (위 EMBEDDING_*와 완전히 별개 — 혼동 금지).
# 팀원이 RAG용 임베딩 모델을 정하기 전까지는 hashing(자리 채우기, GPU 불필요)을
# 쓴다. 정해지면 RAG_EMBEDDING_PROVIDER=sentence_transformer로 바꾸고
# RAG_EMBEDDING_MODEL_NAME에 HuggingFace 모델 이름만 채우면 된다(코드 변경 없음).
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_MODEL_NAME=
RAG_EMBEDDING_DIMENSION=
RAG_EMBEDDING_TRUNCATE_DIM=
RAG_EMBEDDING_REVISION=
RAG_EMBEDDING_TRUST_REMOTE_CODE=false
RAG_EMBEDDING_QUERY_PROMPT_NAME=
RAG_EMBEDDING_DOCUMENT_PROMPT_NAME=
