APP_NAME=Medical AI API
APP_ENV=local
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
MODEL_SCHEMAS=app_db,vector_db
VITE_API_URL=http://localhost:8000/api
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_MINUTES=10

# SMTP를 설정하지 않으면 로컬 환경에서 인증 코드가 API 응답에 포함됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Cloudflare R2 프로필 이미지 저장소
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://assets.example.com

# 공통 ai/ocr Core (PaddleOCR 모델은 최초 OCR 실행 시 다운로드될 수 있습니다.)
OCR_MAX_FILE_SIZE_MB=20
OCR_MAX_PDF_PAGES=50
OCR_NATIVE_TEXT_MIN_CHARS=20
OCR_SIGNIFICANT_IMAGE_AREA_RATIO=0.03
OCR_PDF_RENDER_DPI=200
OCR_MAX_IMAGE_SIDE=2400
OCR_MAX_IMAGE_PIXELS=40000000
OCR_PADDLE_DEVICE=cpu
OCR_PADDLE_LANGUAGE=korean
OCR_MIN_CONFIDENCE=0.5
OCR_ENABLE_DENOISE=true
OCR_ENABLE_DESKEW=true
OCR_JOB_TTL_MINUTES=60
OCR_MAX_PENDING_JOBS=5
OCR_MAX_OFFICE_UNCOMPRESSED_SIZE_MB=200
OCR_MAX_OFFICE_ARCHIVE_ENTRIES=5000

# LLM Provider (Backend 전용 비밀값에는 VITE_ 접두사를 사용하지 않습니다.)
LLM_OLLAMA_ENABLED=true
LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_OLLAMA_MODEL=gemma3:1b
LLM_OLLAMA_TIMEOUT_SECONDS=120
LLM_OLLAMA_MAX_CONCURRENCY=1
LLM_GEMINI_ENABLED=true
GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-3.5-flash-lite
LLM_GEMINI_TIMEOUT_SECONDS=60
LLM_GEMINI_MAX_CONCURRENCY=2

# MedGemma LoRA는 CUDA GPU와 ai/llm/requirements-medgemma.txt 설치가 필요합니다.
LLM_MEDGEMMA_ENABLED=true
LLM_MEDGEMMA_MAX_CONCURRENCY=1
HF_TOKEN=

# OCR Chunk Embedding (DB의 VECTOR(1024)와 차원을 일치시켜야 합니다.)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
