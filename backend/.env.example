APP_NAME=MediSense API
APP_ENV=local
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
MODEL_SCHEMAS=app_db,vector_db
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_MINUTES=10

# 비로그인 게스트 채팅 관련 설정 (하루 단위 아님 — 게스트 계정 하나의 평생 총량)
GUEST_TOKEN_EXPIRE_MINUTES=43200
GUEST_MESSAGE_LIMIT=30
GUEST_ATTACHMENT_LIMIT=5

# SMTP를 설정하지 않으면 로컬 환경에서 인증 코드가 API 응답에 포함됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Cloudflare R2 프로필 이미지 저장소
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ai/llm(MedGemma LoRA 어댑터 호출)용 — private HF Hub repo 읽기 권한이 있는 토큰.
# GPU 있는 환경(관리자 페이지 LLM 비교, 채팅 응답 생성)에서만 필요.
HF_TOKEN=
